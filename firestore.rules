rules_version = '2';

/**
 * El Águila Cocina — Firestore security rules.
 *
 * Identity is decided by the signed-in account's *email address*, and both
 * lists that matter are written from inside the panel:
 *
 *   staff/{email}         — may run the kitchen panel. Managed in
 *                           Ajustes → Equipo.
 *   clientEmails/{email}  — belongs to one farm. Written when the manager
 *                           registers or edits that farm.
 *
 * So onboarding anybody is the same act: type their email into the panel. No
 * Firestore documents to hand-write, no access codes to read over the phone,
 * and nothing in this file to edit after the first day.
 *
 * Why not simply "has an Auth account"? Because this project's API key is
 * public — it ships in the browser — and Firebase's account-creation endpoint
 * is public with it. Anyone can create an Auth account against this project
 * without going near either app, so being in Authentication proves nothing.
 * Being in one of these two lists does, because only an admin can write them.
 *
 * The first admin is the one exception, and it happens once: whoever creates
 * `config/bootstrap` may add themselves to `staff`. Firestore rejects a create
 * on a document that already exists, so that race has exactly one winner and
 * the marker can never be updated or deleted.
 *
 * On list queries: Firestore evaluates these rules against every document a
 * query would return, so an unscoped `list` on deliveries or invoices simply
 * fails. That is what confines a farm to its own rows — the query has to carry
 * `where('clientId', '==', <their own farm>)` to be allowed at all.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* --- Identity ---------------------------------------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    /** The signed-in address, lowercased, or '' when there is none. */
    function myEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isAdmin() {
      return myEmail() != ''
        && exists(/databases/$(database)/documents/staff/$(myEmail()));
    }

    /**
     * The farm this address was registered for, or ''.
     *
     * Note there is no step where a farm claims anything: the manager writes
     * the address, and that write *is* the authorisation. Nothing the farm
     * does can change which farm it belongs to.
     */
    function myClient() {
      return myEmail() != ''
        && exists(/databases/$(database)/documents/clientEmails/$(myEmail()))
        ? get(/databases/$(database)/documents/clientEmails/$(myEmail())).data.clientId
        : '';
    }

    function ownsClient(clientId) {
      return clientId != null && clientId != '' && myClient() == clientId;
    }

    /** The one account that claimed the first-administrator seat. */
    function isFounder() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/bootstrap)
        && get(/databases/$(database)/documents/config/bootstrap).data.ownerUid == request.auth.uid;
    }

    /** Keys this write is changing. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* --- staff -------------------------------------------------------------- */

    // Document id is the lowercased email address. Adding one grants the whole
    // panel — every farm's contact details, every delivery, every payment — so
    // only an existing admin may write here.
    match /staff/{email} {
      // Anyone signed in may check their own entry; that is how the panel
      // knows whether to let them in. Reading somebody else's is admin-only.
      allow get: if isAdmin() || (signedIn() && email == myEmail());
      allow list: if isAdmin();

      // The founder adding themselves, once, right after claiming the seat.
      allow create: if isAdmin()
        || (isFounder() && email == myEmail());

      allow update: if isAdmin();

      // An admin may not lock the kitchen out by removing the last of
      // themselves by accident — that check lives in the app, which can count
      // the collection; rules cannot.
      allow delete: if isAdmin();
    }

    /* --- config ------------------------------------------------------------- */

    // Create-once marker for the first administrator. Never updated, never
    // deleted: the seat cannot be re-claimed.
    match /config/{docId} {
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if docId == 'bootstrap'
        && signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerEmail', 'at'])
        && request.resource.data.ownerUid == request.auth.uid;

      allow update, delete: if false;
    }

    /* --- clientEmails -------------------------------------------------------- */

    // Which farm an address belongs to. Written by the panel when a farm is
    // registered or its email changed; read by that farm to find itself.
    match /clientEmails/{email} {
      allow get: if isAdmin() || (signedIn() && email == myEmail());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    /* --- users --------------------------------------------------------------- */

    // Personal details only — a display name and a phone number. This document
    // carries no authority at all: who you are is decided by `staff` and
    // `clientEmails`, both of which only an admin can write.
    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow create, update: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(
                 ['name', 'email', 'phone', 'createdAt', 'updatedAt', 'lastSeenAt']));

      allow delete: if isAdmin();
    }

    /* --- clients (farms) ------------------------------------------------------ */

    match /clients/{clientId} {
      allow get: if isAdmin() || ownsClient(clientId);
      allow list: if isAdmin();

      // A farm reads its own terms and can never edit them. Its price per meal
      // is the kitchen's to set.
      allow write: if isAdmin();
    }

    /* --- deliveries ----------------------------------------------------------- */

    match /deliveries/{deliveryId} {
      allow read: if isAdmin() || ownsClient(resource.data.clientId);
      allow write: if isAdmin();
    }

    /* --- invoices ------------------------------------------------------------- */

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || ownsClient(resource.data.clientId);
      // Money is written by the kitchen only. A farm can see what it owes and
      // talk about it, never change it.
      allow write: if isAdmin();
    }

    /* --- conversations -------------------------------------------------------- */

    match /conversations/{clientId} {
      allow get: if isAdmin() || ownsClient(clientId);
      allow list: if isAdmin();

      // Both sides maintain the thread summary as they post. A farm may only
      // touch its own thread, and only the fields a message send updates.
      allow create: if isAdmin() || ownsClient(clientId);
      allow update: if isAdmin()
        || (ownsClient(clientId)
            && changed().hasOnly([
                 'clientId', 'clientName', 'lastMessage', 'lastAt', 'lastSenderRole',
                 'lastSenderName', 'lastKind', 'unreadAdmin', 'unreadClient',
                 'clientReadAt', 'members', 'updatedAt',
               ]));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || ownsClient(clientId);

        // You may only post as yourself, and only into your own thread.
        allow create: if (isAdmin() || ownsClient(clientId))
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderRole in ['admin', 'client']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        // System notes are written by the kitchen alongside a payment or an
        // incident; they carry no sender.
        allow create: if isAdmin()
          && request.resource.data.senderRole == 'system';

        // A sent message is a record. Nobody edits or deletes it.
        allow update, delete: if false;
      }
    }

    /* --- everything else ------------------------------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
